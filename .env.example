# ---------------------------------------------------------------------------
# Marquee — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must never contain a real credential.
#
# The app runs with NO .env file at all — it falls back to the mock provider.
# ---------------------------------------------------------------------------

# Which content provider backs the app: `mock` | `tmdb`
# Safe to expose to the browser — it is a mode flag, not a secret.
# Defaults to `mock` when unset, so the app works with zero configuration.
NEXT_PUBLIC_CONTENT_PROVIDER=mock

# TMDB API v4 Read Access Token, sent as `Authorization: Bearer <token>`.
# Get one at https://www.themoviedb.org/settings/api (the long JWT-looking
# string under "API Read Access Token", NOT the short v3 "API Key").
#
# SERVER-ONLY. Never rename this with a NEXT_PUBLIC_ prefix — that would inline
# the token into the client bundle and publish it to every visitor.
# Only required when NEXT_PUBLIC_CONTENT_PROVIDER=tmdb.
TMDB_READ_ACCESS_TOKEN=

# OMDb API key, for external ratings (IMDb / Rotten Tomatoes / Metacritic).
# Free key: https://www.omdbapi.com/apikey.aspx
#
# SERVER-ONLY, same rules as the TMDB token above — never NEXT_PUBLIC_.
# OMDb only accepts the key as a query parameter (no header form exists), so
# the URL is built server-side in lib/content/omdb/client.ts and never logged.
#
# OPTIONAL. Leaving this blank is a supported configuration, not a broken one:
# getExternalRatings() returns [] and the detail page renders with TMDB's own
# score. The free tier allows 1,000 requests/day, which is why responses are
# cached for 7 days at both the fetch and the CDN.
OMDB_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (Phase 6 — accounts and cross-device sync)
#
# ALL THREE ARE OPTIONAL. With them blank the app is anonymous and local-only,
# exactly as it behaves today — that is the zero-config promise, not a
# degraded mode. See docs/phase-6-sync-design.md.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
# PUBLIC BY DESIGN — it is an endpoint, not a secret.
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` publishable key.
#
# PUBLIC BY DESIGN. This one looks alarming and is not: the browser has to
# authenticate with something, and Supabase's model assumes this key is
# visible to anyone. It is safe ONLY because Row Level Security is enabled on
# every table (supabase/migrations/), so holding it grants no data access on
# its own. If RLS were ever disabled on a table, this key would make that
# table world-readable — which is why the migration refuses to apply if any
# public table lacks RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` secret key.
#
# ⚠ SERVER-ONLY, AND THE MOST DANGEROUS CREDENTIAL IN THIS FILE. It carries
# BYPASSRLS: every policy in the schema is ignored for it. Leaking it is not
# "some data exposed", it is total silent access to every user's library,
# ratings, private notes and watch history.
#
# NEVER rename this with a NEXT_PUBLIC_ prefix. It is read only via
# lib/supabase/server-env.ts, which is `server-only`, so a client import is a
# build error rather than a runtime leak.
#
# ⚠️ REQUIRED BY EXACTLY ONE CODE PATH, as of Phase 7 Step 5: the notification
# cron (`app/api/cron/notifications`), which must read every user's follow
# rows and write to their notification queue — something RLS own-rows policies
# exist to forbid, and which has no `auth.uid()` to act as.
#
# It is reached ONLY through `lib/notifications/server/store.ts`, which never
# exports its client and whose table access is a typed allowlist. A guard test
# asserts that module stays the only importer of `lib/supabase/server-env`.
#
# Leave BLANK unless you are running notifications. Blank means the cron
# reports `skipped: not-configured` and everything else works normally.
# Prefer the user's own JWT anywhere else — it is subject to RLS; this is not.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (Phase 7 Step 5) — new-episode notifications
# ---------------------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
#
# Blank is a SUPPORTED configuration: the settings page says notifications
# aren't set up on this server, the cron skips delivery, and nothing else
# changes. Same zero-config promise as a blank OMDB_API_KEY.

# PUBLIC by design — the browser must have it to create a subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# SECRET. Never prefix this NEXT_PUBLIC_. Signs the VAPID JWT that identifies
# this server to push services; leaking it lets someone send notifications
# that appear to come from you.
VAPID_PRIVATE_KEY=

# How a push provider contacts an operator whose traffic is misbehaving.
# Must be a mailto: or https: URL. Optional; defaults to a placeholder.
VAPID_CONTACT=

# SECRET. The only thing standing between an anonymous caller and the
# service-role code path above — `app/api/cron/notifications` returns 404
# without it, and refuses to run at all if it is unset (an unset secret must
# never mean "allow all").
#
# Set the SAME value in whatever calls the endpoint. Deployment, per
# docs/phase-7-notifications-design.md §3.2: an external scheduler hourly,
# plus Vercel's own daily cron as a floor — Vercel Hobby cannot schedule more
# often than daily, and a daily-only run would permanently silence any user
# whose quiet hours contain the run's hour.
CRON_SECRET=

# The canonical, user-facing origin, e.g. https://marquee.example.com
# No trailing slash.
#
# PUBLIC — it is the address of this site.
#
# Only used to build the links Supabase puts in confirmation and password-reset
# emails. OAuth and in-app flows derive their origin from the request instead,
# so a local dev session and a preview deploy each call back to themselves.
#
# OPTIONAL, and worth setting in production specifically because the fallback
# is `VERCEL_URL` — which is the per-DEPLOYMENT hostname and changes on every
# push. Without this, a confirmation email would link a user to whichever
# preview build happened to send it. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
