# ---------------------------------------------------------------------------
# Marquee — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must never contain a real credential.
#
# The app runs with NO .env file at all — it falls back to the mock provider.
# ---------------------------------------------------------------------------

# Which content provider backs the app: `mock` | `tmdb`
# Safe to expose to the browser — it is a mode flag, not a secret.
# Defaults to `mock` when unset, so the app works with zero configuration.
NEXT_PUBLIC_CONTENT_PROVIDER=mock

# TMDB API v4 Read Access Token, sent as `Authorization: Bearer <token>`.
# Get one at https://www.themoviedb.org/settings/api (the long JWT-looking
# string under "API Read Access Token", NOT the short v3 "API Key").
#
# SERVER-ONLY. Never rename this with a NEXT_PUBLIC_ prefix — that would inline
# the token into the client bundle and publish it to every visitor.
# Only required when NEXT_PUBLIC_CONTENT_PROVIDER=tmdb.
TMDB_READ_ACCESS_TOKEN=

# OMDb API key, for external ratings (IMDb / Rotten Tomatoes / Metacritic).
# Free key: https://www.omdbapi.com/apikey.aspx
#
# SERVER-ONLY, same rules as the TMDB token above — never NEXT_PUBLIC_.
# OMDb only accepts the key as a query parameter (no header form exists), so
# the URL is built server-side in lib/content/omdb/client.ts and never logged.
#
# OPTIONAL. Leaving this blank is a supported configuration, not a broken one:
# getExternalRatings() returns [] and the detail page renders with TMDB's own
# score. The free tier allows 1,000 requests/day, which is why responses are
# cached for 7 days at both the fetch and the CDN.
OMDB_API_KEY=
